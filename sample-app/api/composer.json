{
  "name": "metergate/sample-api",
  "type": "project",
  "description": "Minimal Laravel GraphQL API used by MeterGate proxy and provider demos.",
  "license": "MIT",
  "require": {
    "php": "8.4.14",
    "dedoc/scramble": "0.12.36",
    "laravel/framework": "12.40.1",
    "nuwave/lighthouse": "6.63.1"
  },
  "require-dev": {
    "laravel/pint": "1.25.1",
    "phpunit/phpunit": "12.4.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
    ],
    "lint": "pint --test",
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": false
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

