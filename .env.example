NODE_ENV=development
METERGATE_MODE=proxy
METERGATE_PORT=3000
METERGATE_CONFIG_PATH=config/metergate.yml
METERGATE_API_KEY_HEADER=x-api-key
METERGATE_KEY_HASH_SECRET=local-demo-secret-change-me
DATABASE_URL=postgresql://metergate:metergate@postgres:5432/metergate?schema=public
REDIS_URL=redis://redis:6379
OTEL_EXPORTER=stdout,file
OTEL_FILE_PATH=/app/otel-output/metergate.ndjson
LOG_LEVEL=info

SAMPLE_API_PORT=8000
SAMPLE_WEB_PORT=5173
SAMPLE_API_URL=http://sample-api:8000
SAMPLE_WEB_API_KEY=mg_demo_local_plaintext_key
METERGATE_PROVIDER_URL=http://metergate:3000/v1/check
VITE_METERGATE_MODE=proxy
VITE_PROXY_GRAPHQL_URL=http://localhost:3000/graphql
VITE_PROVIDER_GRAPHQL_URL=http://localhost:8000/graphql
VITE_DEMO_API_KEY=mg_demo_local_plaintext_key

