{
  "name": "MeterGate",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/metergate",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bmewburn.vscode-intelephense-client",
        "Prisma.prisma"
      ]
    }
  },
  "postCreateCommand": "npm ci && cd sample-app/web && npm ci && cd ../api && composer install"
}
